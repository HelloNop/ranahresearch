# Local development only. Compose works with these defaults without copying this file.
POSTGRES_PASSWORD=ranah-local-only
POSTGRES_PORT=5432
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8080
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY_ID=ranah-local
S3_SECRET_ACCESS_KEY=ranah-local-secret
S3_BUCKET=ranahresearch
# Used by ranah_domain (EPIC-003) and the orchestration worker (EPIC-005).
DATABASE_URL=postgresql+psycopg://ranah:ranah-local-only@127.0.0.1:5432/ranahresearch
SCREENING_BATCH_SIZE=10
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_REGION=us-east-1
# Real key required only to actually call OpenAI; never commit a real value here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional provider credentials. OpenAlex accepts api_key; Semantic Scholar accepts x-api-key.
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# Local bearer-token to user UUID mapping, created by scripts/bootstrap_local.py.
RANAH_API_TOKENS={}
RANAH_TASK_QUEUE=orchestration
